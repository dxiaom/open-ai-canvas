{
    "rewrites": [
        {
            "source": "/*",
            "destination": "/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/api/*",
            "destination": "https://huabu-api.wavee.cn/api/:splat",
            "statusCode": 302
        }
    ],
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        },
        {
            "source": "/assets/*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "max-age=31536000"
                }
            ]
        }
    ]
}
